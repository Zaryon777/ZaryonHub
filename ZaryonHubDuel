--========================================================
-- GROUND POSITION
--========================================================

local function GroundPosition(X,Z)

	local Origin =
		Vector3.new(X,500,Z)

	local Direction =
		Vector3.new(0,-1000,0)

	local Params =
		RaycastParams.new()

	Params.FilterType =
		Enum.RaycastFilterType.Exclude

	Params.FilterDescendantsInstances =
		{Character}

	local Result =
		Workspace:Raycast(
			Origin,
			Direction,
			Params
		)

	if Result then

		local Height =
			Humanoid
			and Humanoid.HipHeight
			or 2

		return Vector3.new(
			X,
			Result.Position.Y+Height+1,
			Z
		)

	end

	return Vector3.new(X,5,Z)

end

