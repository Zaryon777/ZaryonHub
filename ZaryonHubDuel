		Character:FindFirstChild("Animate")

	if State.UnWalk then

		if Animate then

			SavedAnimateScript =
				Animate.Disabled

			Animate.Disabled = true

		end

		if Humanoid then

			Humanoid.AutoRotate = false

		end

	else

