local accumulated = 0

RunService.Heartbeat:Connect(
    function(dt)

        accumulated += dt

        local humanoid =
            getHumanoid()

        if humanoid then

            if Settings.LaggerCarryEnabled then

                humanoid.WalkSpeed =
                    Settings.LaggerCarry

            elseif Settings.LaggerSpeedEnabled then

                humanoid.WalkSpeed =
                    Settings.LaggerSpeed

            elseif Settings.CarrySpeedEnabled then

                humanoid.WalkSpeed =
                    Settings.CarrySpeed

            else

                humanoid.WalkSpeed =
                    Settings.Speed
            end

            if Settings.UnWalk then
                humanoid.AutoRotate = false
            else
                humanoid.AutoRotate = true
            end
        end

        if Settings.FOV then

            local camera =
                workspace.CurrentCamera

            if camera
                and math.abs(
                    camera.FieldOfView
                    - Settings.FOV
                ) > 0.1 then

                camera.FieldOfView =
                    Settings.FOV
            end
        end

        if Settings.TPDown
            and accumulated >= 0.25 then

            accumulated = 0

            teleportDown()
        end
    end
)

