--========================================================
-- BAT TP
--========================================================

local function BatTPUpdate()

	if not State.BatTP or not Root then
		return
	end

	local Target =
		GetNearestPlayer()

	if not Target or not Target.Character then
		return
	end

	local TargetRoot =
		Target.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not TargetRoot then
		return
	end

	local Angle =
		os.clock()*State.AimbotSpeed

	local Offset =
		CFrame.new(
			0,
			4,
			0
		)
		*
		CFrame.Angles(
			0,
			Angle,
			0
		)

	Root.CFrame =
		TargetRoot.CFrame * Offset

end

--========================================================
-- ANTI BAT BYPASS
--========================================================

local function AntiBatUpdate()

	if not State.AntiBatBypass or not Root then
		return
	end

	local Target =
		GetNearestPlayer()

	if not Target or not Target.Character then
		return
	end

	local TargetRoot =
		Target.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not TargetRoot then
		return
	end

	local Direction =
		TargetRoot.Position-Root.Position

	local Distance =
		Direction.Magnitude

	if Distance > 3 then

		local Step =
			math.min(
				Distance,
				State.AimbotSpeed*0.08
			)

		Root.CFrame =
			CFrame.new(
				Root.Position+
				Direction.Unit*Step,
				TargetRoot.Position
			)

	end

	ActivateFirstTool()

end

