local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or COLORS.Gray
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

local function label(parent, text, size, position, dimensions)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Settings.ButtonTextColor
    l.Font = Enum.Font.Gotham
    l.TextSize = size or 14
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Position = position or UDim2.new()
    l.Size = dimensions or UDim2.new(1, 0, 0, 30)
    l.Parent = parent
    return l
end

local function button(parent, text, position, size)
    local b = Instance.new("TextButton")

    b.AutoButtonColor = false
    b.Text = text
    b.TextColor3 = Settings.ButtonTextColor
    b.Font = Enum.Font.Gotham
    b.TextSize = 13
    b.BackgroundColor3 = Settings.ButtonColor
    b.BorderSizePixel = 0
    b.Position = position
    b.Size = size
    b.Parent = parent

    corner(b, 6)
    stroke(b, Settings.InterfaceBorderColor, 1)

    return b
end

local function setButtonState(b, active)
    if active then
        b.BackgroundColor3 = COLORS.White
        b.TextColor3 = COLORS.Black
    else
        b.BackgroundColor3 = Settings.ButtonColor
        b.TextColor3 = Settings.ButtonTextColor
    end
end

local function addPressEffect(b)
    b.Activated:Connect(function()
        local original = b.Size

        local smaller = UDim2.new(
            original.X.Scale,
            original.X.Offset - 4,
            original.Y.Scale,
            original.Y.Offset - 4
        )

        TweenService:Create(
            b,
            TweenInfo.new(
                0.06,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {Size = smaller}
        ):Play()

        task.delay(0.06, function()
            if b.Parent then
                TweenService:Create(
                    b,
                    TweenInfo.new(
                        0.06,
                        Enum.EasingStyle.Quad,
                        Enum.EasingDirection.Out
                    ),
                    {Size = original}
                ):Play()
            end
        end)
    end)
end

