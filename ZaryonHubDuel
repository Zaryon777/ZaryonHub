local function createRightButton(
    name,
    topText,
    bottomText,
    callback
)

    local button = Instance.new("TextButton")

    button.Name = name
    button.Size = UDim2.new(0,95,0,62)
    button.BackgroundColor3 = BLACK
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = RightButtons

    corner(button,6)
    stroke(button,Config.InterfaceBorderColor,1)

    local top = createText(
        button,
        topText,
        13,
        UDim2.new(0,0,0,5),
        UDim2.new(1,0,0.5,-5)
    )

    top.TextColor3 = Config.TextColor
    top.Font = Enum.Font.GothamBold

    local bottom = createText(
        button,
        bottomText,
        13,
        UDim2.new(0,0,0.5,0),
        UDim2.new(1,0,0.5,-5)
    )

    bottom.TextColor3 = Config.TextColor
    bottom.Font = Enum.Font.GothamBold

    local active = false

    local function setActive(state)

        active = state

        if active then

            tween(button,{
                BackgroundColor3 = WHITE
            },0.12)

            top.TextColor3 = BLACK
            bottom.TextColor3 = BLACK

        else

            tween(button,{
                BackgroundColor3 = BLACK
            },0.12)

            top.TextColor3 = Config.TextColor
            bottom.TextColor3 = Config.TextColor

        end

        if callback then
            callback(active)
        end

    end

    button.MouseButton1Click:Connect(function()
        setActive(not active)
    end)

    return button,setActive
end

