local function SelectCategory(Name)

	State.Category = Name

	for Category,Button in pairs(CategoryButtons) do

		if Category == Name then

			Button.BackgroundColor3 = State.White
			Button.TextColor3 = State.Black

		else

			Button.BackgroundColor3 = State.ButtonColor
			Button.TextColor3 = State.TextColor

		end

	end

	if Builders[Name] then
		Builders[Name]()
	end

end

