local function CreateNumberSetting(parent, titleText, defaultVal, yPos, callback)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.5, 0, 0, 24)
	label.Position = UDim2.new(0.02, 0, 0, yPos)
	label.Text = titleText
	label.TextColor3 = Theme.Text
	label.Font = Enum.Font.Gotham
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	label.Parent = parent

	local minus = Instance.new("TextButton")
	minus.Size = UDim2.new(0, 22, 0, 22)
	minus.Position = UDim2.new(0.55, 0, 0, yPos)
	minus.BackgroundColor3 = Theme.InactiveBtn
	minus.TextColor3 = Theme.Text
	minus.Text = "-"
	minus.Font = Enum.Font.GothamBold
	minus.Parent = parent
	Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)
	Instance.new("UIStroke", minus).Color = Theme.Accent

	local valBox = Instance.new("TextBox")
	valBox.Size = UDim2.new(0, 38, 0, 22)
	valBox.Position = UDim2.new(0.55, 26, 0, yPos)
	valBox.Text = tostring(defaultVal)
	valBox.TextColor3 = Theme.Text
	valBox.Font = Enum.Font.GothamSemibold
	valBox.TextSize = 12
	valBox.BackgroundColor3 = Theme.InactiveBtn
	valBox.Parent = parent
	Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 4)
	Instance.new("UIStroke", valBox).Color = Theme.Accent

	local plus = Instance.new("TextButton")
	plus.Size = UDim2.new(0, 22, 0, 22)
	plus.Position = UDim2.new(0.55, 68, 0, yPos)
	plus.BackgroundColor3 = Theme.InactiveBtn
	plus.TextColor3 = Theme.Text
	plus.Text = "+"
	plus.Font = Enum.Font.GothamBold
	plus.Parent = parent
	Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)
	Instance.new("UIStroke", plus).Color = Theme.Accent

	local val = defaultVal
	local function update(n)
		val = math.max(0, n)
		valBox.Text = tostring(val)
		callback(val)
	end
	
	minus.MouseButton1Click:Connect(function() update(val - 1) end)
	plus.MouseButton1Click:Connect(function() update(val + 1) end)
	valBox.FocusLost:Connect(function() update(tonumber(valBox.Text) or val) end)
end

local function CreateToggle(parent, titleText, yPos, callback)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.5, 0, 0, 24)
	label.Position = UDim2.new(0.02, 0, 0, yPos)
	label.Text = titleText
	label.TextColor3 = Theme.Text
	label.Font = Enum.Font.Gotham
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	label.Parent = parent

	local oval = Instance.new("TextButton")
	oval.Size = UDim2.new(0, 42, 0, 20)
	oval.Position = UDim2.new(0.72, 0, 0, yPos + 2)
	oval.BackgroundColor3 = Theme.InactiveBtn
	oval.Text = ""
	oval.AutoButtonColor = false
	oval.Parent = parent
	
	Instance.new("UICorner", oval).CornerRadius = UDim.new(1, 0)
	Instance.new("UIStroke", oval).Color = Theme.Accent

	local circle = Instance.new("Frame")
	circle.Size = UDim2.new(0, 16, 0, 16)
	circle.Position = UDim2.new(1, -18, 0, 2) -- Inactivo derecha
	circle.BackgroundColor3 = Theme.Text
	circle.Parent = oval
	Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

	local toggled = false
	oval.MouseButton1Click:Connect(function()
		toggled = not toggled
		TweenService:Create(circle, TweenInfo.new(0.15), {
			Position = toggled and UDim2.new(0, 2, 0, 2) or UDim2.new(1, -18, 0, 2),
			BackgroundColor3 = toggled and Theme.TextDark or Theme.Text
		}):Play()
		TweenService:Create(oval, TweenInfo.new(0.15), {
			BackgroundColor3 = toggled and Theme.ActiveBtn or Theme.InactiveBtn
		}):Play()
		callback(toggled)
	end)
end

