local AutoStealPercent = 0
local LastMovement = os.clock()
local LastPromptActivation = 0

local FPSLabel
local PingLabel
local PercentLabel
local PercentFill

local function GetFPS()

	local Delta =
		RunService.RenderStepped:Wait()

	if Delta <= 0 then
		return 0
	end

	return math.floor(1/Delta)

end

local function GetPing()

	local Success,Result =
		pcall(function()

			return Stats
				.Network
				.ServerStatsItem
				["Data Ping"]
				:GetValue()

		end)

	if Success then
		return math.floor(Result)
	end

	return 0

end

local function FindNearestPrompt()

	if not Root then
		return nil
	end

	local Nearest
	local Distance = math.huge

	for _,Object in ipairs(
		Workspace:GetDescendants()
	) do

		if Object:IsA("ProximityPrompt")
			and Object.Enabled
		then

			local Parent = Object.Parent

			if Parent then

				local Position

				if Parent:IsA("BasePart") then

					Position = Parent.Position

				elseif Parent:IsA("Attachment") then

					Position = Parent.WorldPosition

				end

				if Position then

					local D =
						(Position-Root.Position).Magnitude

					if D < Distance then

						Distance = D
						Nearest = Object

					end

				end

			end

		end

	end

	return Nearest

end

local function UpdateAutoSteal()

	if not Root then
		return
	end

	local Moving =
		Humanoid
		and Humanoid.MoveDirection.Magnitude > .05

	if Moving or State.AutoRight or State.AutoLeft then

		LastMovement = os.clock()

		AutoStealPercent =
			math.clamp(
				AutoStealPercent+
				(100/3)*0.05,
				0,
				100
			)

	else

		if os.clock()-LastMovement >= 3 then

			AutoStealPercent = 0

		end

	end

	if State.AutoSteal
		and AutoStealPercent >= 100
	then

		if os.clock()-LastPromptActivation >= 3 then

			local Prompt =
				FindNearestPrompt()

			if Prompt then

				LastPromptActivation =
					os.clock()

				pcall(function()

					fireproximityprompt(
						Prompt
					)

				end)

			end

		end

	end

	if PercentFill then

		PercentFill.Size =
			UDim2.new(
				AutoStealPercent/100,
				0,
				1,
				0
			)

	end

	if PercentLabel then

		PercentLabel.Text =
			math.floor(AutoStealPercent).."%"

	end

end

