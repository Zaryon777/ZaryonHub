	local oval = Instance.new("TextButton")
	oval.Size = UDim2.new(0, 42, 0, 20)
	oval.Position = UDim2.new(0.72, 0, 0, yPos + 2)
	oval.BackgroundColor3 = Theme.ButtonBg
	oval.Text = ""
	oval.Parent = parent
	
	Instance.new("UICorner", oval).CornerRadius = UDim.new(1, 0)
	Instance.new("UIStroke", oval).Color = Theme.Borders

	local circle = Instance.new("Frame")
	circle.Size = UDim2.new(0, 16, 0, 16)
	circle.Position = UDim2.new(1, -18, 0, 2)
	circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	circle.Parent = oval
	Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

	local active = false
	oval.MouseButton1Click:Connect(function()
		active = not active
		if active then
			circle:TweenPosition(UDim2.new(0, 2, 0, 2), "Out", "Quad", 0.12, true)
			oval.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			circle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		else
			circle:TweenPosition(UDim2.new(1, -18, 0, 2), "Out", "Quad", 0.12, true)
			oval.BackgroundColor3 = Theme.ButtonBg
			circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		end
		callback(active)
	end)
end

