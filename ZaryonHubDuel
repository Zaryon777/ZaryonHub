--========================================================
-- DROP BRAINROT
--========================================================

local DropRunning = false

local function DropBrainrotAction()

	if DropRunning or not Root then
		return
	end

	DropRunning = true

	local Start =
		Root.Position

	local Up =
		Start + Vector3.new(0,50,0)

	local StartTime = os.clock()

	while
		Root
		and Root.Parent
		and os.clock()-StartTime < .5
	do

		local Alpha =
			math.clamp(
				(os.clock()-StartTime)/.5,
				0,
				1
			)

		Root.CFrame =
			CFrame.new(
				Start:Lerp(Up,Alpha)
			)

		RunService.Heartbeat:Wait()

	end

	if Root then

		local Ground =
			GroundPosition(
				Root.Position.X,
				Root.Position.Z
			)

		Root.CFrame =
			CFrame.new(Ground)

	end

	DropRunning = false

end

