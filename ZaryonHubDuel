-- Main Loop de Actualización (Heartbeat)
RunService.Heartbeat:Connect(function(dt)
	local character = LocalPlayer.Character
	if not character or not character:FindFirstChild("Humanoid") or not character:FindFirstChild("HumanoidRootPart") then return end
	local humanoid = character.Humanoid
	local hrp = character.HumanoidRootPart

	-- Lógica de Velocidad Base y Multiplicadores
	local baseSpeed = Variables.Speed
	if Variables.CarrySpeed then baseSpeed = Variables.CarrySpeed end
	if Variables.LaggerCarry then baseSpeed = Variables.LaggerCarry end
	if Variables.LaggerSpeed then baseSpeed = Variables.LaggerSpeed end
	if Variables.AutoLeft or Variables.AutoRight then baseSpeed = 59 end
	
	humanoid.WalkSpeed = baseSpeed

	-- TP Down
	if Variables.TPDown then
		local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
		local hit, pos = workspace:FindPartOnRayWithIgnoreList(ray, {character})
		if hit then
			hrp.CFrame = CFrame.new(pos + Vector3.new(0, humanoid.HipHeight + 0.5, 0))
		end
		-- Desactivar después de un uso (como describe la instrucción)
		if FeatureElements["TPDown"] and FeatureElements["TPDown"].ToggleBtn then FeatureElements["TPDown"].ToggleBtn.MouseButton1Click:Fire() end
		if FeatureElements["TPDown"] and FeatureElements["TPDown"].FastButton then FeatureElements["TPDown"].FastButton.MouseButton1Click:Fire() end
	end

	-- Bat TP
	if Variables.BatTP then
		local targetPlayer = GetClosestPlayer()
		if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
			local targetHrp = targetPlayer.Character.HumanoidRootPart
			local rotationSpeed = Variables.AimbotSpeed / 10 -- Ajustar velocidad de giro
			hrp.CFrame = CFrame.new(targetHrp.Position + Vector3.new(0, 5, 0)) * CFrame.Angles(0, math.rad(tick() * rotationSpeed * 360), 0)
			
			-- Equipar y hacer clicks
			EquipItemInSlot(1)
			-- Lógica de click automatizada (requiere simulación de input o eventos remotos del juego)
			-- Esto es complejo en Roblox sin soporte del juego. Se asume que EquipItem y Click son eventos.
			-- *Simulación de click aquí si fuera posible*
		else
			Variables.BatTP = false -- Desactivar si no hay objetivo
		end
	end
	
	-- Anti Bat Bypass (Volar hacia objetivo)
	if Variables.AntiBatBypass then
		local targetPlayer = GetClosestPlayer()
		if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
			local targetHrp = targetPlayer.Character.HumanoidRootPart
			local moveDir = (targetHrp.Position - hrp.Position).Unit
			hrp.Velocity = moveDir * Variables.AimbotSpeed -- Usar AimbotSpeed como velocidad de vuelo
			-- Evitar caídas
			if hrp.Velocity.Y < 0 then hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z) end

			EquipItemInSlot(1)
			-- *Simulación de click aquí si fuera posible cada 0.5s*
		else
			hrp.Velocity = Vector3.new(0, 0, 0) -- Detener vuelo
		end
	end

	-- Auto Right / Auto Left (Moverse a coordenadas)
	local targetX = -74.875
	local targetZ = Variables.AutoRight and -24.304 or (Variables.AutoLeft and 41.646 or nil)
	if targetZ then
		local targetPos = Vector3.new(targetX, hrp.Position.Y, targetZ)
		humanoid:MoveTo(targetPos)
	end

	-- Drop Brainrot
	if Variables.DropBrainrot then
		-- Volar 50 studs arriba
		local bodyVelocity = hrp:FindFirstChild("DropBrainrotBV")
		if not bodyVelocity then
			bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Name = "DropBrainrotBV"
			bodyVelocity.Velocity = Vector3.new(0, 100, 0) -- Velocidad de subida
			bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
			bodyVelocity.Parent = hrp
		end
		
		-- Comprobar altura
		local startY = bodyVelocity:GetAttribute("StartY")
		if not startY then
			bodyVelocity:SetAttribute("StartY", hrp.Position.Y)
			startY = hrp.Position.Y
		end
		
		if hrp.Position.Y >= startY + 50 then
			bodyVelocity:Destroy() -- Detener subida
			-- TP Down
			local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
			local hit, pos = workspace:FindPartOnRayWithIgnoreList(ray, {character})
			if hit then
				hrp.CFrame = CFrame.new(pos + Vector3.new(0, humanoid.HipHeight + 0.5, 0))
			end
			-- Desactivar
			if FeatureElements["DropBrainrot"] and FeatureElements["DropBrainrot"].ToggleBtn then FeatureElements["DropBrainrot"].ToggleBtn.MouseButton1Click:Fire() end
			if FeatureElements["DropBrainrot"] and FeatureElements["DropBrainrot"].FastButton then FeatureElements["DropBrainrot"].FastButton.MouseButton1Click:Fire() end
		end
	end

	-- Lógica de Auto Stealer (Progreso)
	local isMoving = (hrp.Position - lastPlayerPos).Magnitude > 0.1 or Variables.AutoRight or Variables.AutoLeft
	lastPlayerPos = hrp.Position
	
	if isMoving then
		stopTimer = 0
		StealProgress = math.clamp(StealProgress + dt / 3, 0, 1) -- 3 segundos para llegar al 100%
	else
		stopTimer += dt
		if stopTimer >= 3 then
			StealProgress = 0
		end
	end
	
	-- Actualizar Barra Visual
	ProgressBar.Size = UDim2.new(StealProgress, 0, 1, 0)
	ProgressText.Text = math.floor(StealProgress * 100) .. "%"
	
	-- Interactuar con ProximityPrompt al 100%
	if StealProgress >= 1 and Variables.AutoSteal then
		-- Buscar prompt cercano
		for _, part in pairs(workspace:GetDescendants()) do
			if part:IsA("ProximityPrompt") then
				local dist = (hrp.Position - part.Parent.Position).Magnitude
				if dist <= part.MaxActivationDistance then
					HandleProximityPrompt(part)
					break
				end
			end
		end
	end
end)

