local function toggleExternal(action)
    if action == "Auto Right" then

        Settings.AutoRight =
            not Settings.AutoRight

        if Settings.AutoRight then
            Settings.AutoLeft = false

            moveToCoordinate(
                -74.875,
                -24.304
            )
        end

    elseif action == "Auto Left" then

        Settings.AutoLeft =
            not Settings.AutoLeft

        if Settings.AutoLeft then
            Settings.AutoRight = false

            moveToCoordinate(
                -74.875,
                41.646
            )
        end

    elseif action == "Carry Speed" then

        Settings.CarrySpeedEnabled =
            not Settings.CarrySpeedEnabled

    elseif action == "Lagger Carry" then

        Settings.LaggerCarryEnabled =
            not Settings.LaggerCarryEnabled

    elseif action == "Lagger Speed" then

        Settings.LaggerSpeedEnabled =
            not Settings.LaggerSpeedEnabled

    elseif action == "TP Down" then

        teleportDown()

    elseif action == "Reset" then

        local humanoid =
            getHumanoid()

        if humanoid then
            humanoid.Health = 0
        end

    else

        notify(
            action ..
            " is disabled in the safe Studio build."
        )
    end
end

UserInputService.InputBegan:Connect(
    function(input, processed)
        if processed then
            return
        end

        if input.UserInputType ~=
            Enum.UserInputType.Keyboard then
            return
        end

        for action, key in pairs(
            Keybinds
        ) do
            if input.KeyCode == key then
                toggleExternal(action)
                break
            end
        end
    end
)

