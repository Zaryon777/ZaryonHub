-- Funciones de Lógica de Toggles Específicos
function HandleToggleLogic(varName, newState)
	if varName == "UnWalk" then
		local humanoid = LocalPlayer.Character.Humanoid
		if newState then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
			-- Congelar animaciones
			for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end
		else
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
	elseif varName == "AntiRadgoll" then
		-- Lógica para prevenir o curar Ragdoll instantáneamente
		-- Depende del sistema de ragdoll del juego
	elseif varName == "AntiLag" then
		-- Visualmente para el jugador:
		for _, part in pairs(workspace:GetDescendants()) do
			if part:IsA("BasePart") then
				if newState then
					part:SetAttribute("OriginalMaterial", part.Material)
					part.Material = Enum.Material.Plastic
					-- Detener animaciones visuales (como las de 'noobini pizzanini')
					if part.Parent:FindFirstChild("Humanoid") then
						for _, track in pairs(part.Parent.Humanoid:GetPlayingAnimationTracks()) do track:AdjustSpeed(0) end
					end
				else
					local originalMaterial = part:GetAttribute("OriginalMaterial")
					if originalMaterial then part.Material = originalMaterial end
					if part.Parent:FindFirstChild("Humanoid") then
						for _, track in pairs(part.Parent.Humanoid:GetPlayingAnimationTracks()) do track:AdjustSpeed(1) end
					end
				end
			end
		end
	elseif varName == "AutoRight" and newState then
		FeatureElements["AutoLeft"].ToggleBtn.MouseButton1Click:Fire() -- Desactivar el otro
	elseif varName == "AutoLeft" and newState then
		FeatureElements["AutoRight"].ToggleBtn.MouseButton1Click:Fire() -- Desactivar el otro
	end
end

