local function numberControl(parent, name, value, y, callback)

    label(
        parent,
        name,
        UDim2.fromOffset(120, 30),
        UDim2.fromOffset(5, y),
        14
    )

    local minus = button(
        parent,
        "-",
        UDim2.fromOffset(30, 28),
        UDim2.fromOffset(125, y)
    )

    local box = Instance.new("TextBox")
    box.BackgroundTransparency = 1
    box.TextColor3 = CONFIG.TextColor
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    box.Text = tostring(value)
    box.ClearTextOnFocus = false
    box.Size = UDim2.fromOffset(48, 28)
    box.Position = UDim2.fromOffset(158, y)
    box.Parent = parent

    local plus = button(
        parent,
        "+",
        UDim2.fromOffset(30, 28),
        UDim2.fromOffset(208, y)
    )

    minus.MouseButton1Click:Connect(function()
        value = value - 1
        box.Text = tostring(value)

        if callback then
            callback(value)
        end
    end)

    plus.MouseButton1Click:Connect(function()
        value = value + 1
        box.Text = tostring(value)

        if callback then
            callback(value)
        end
    end)

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)

        if n then
            value = n
            box.Text = tostring(value)

            if callback then
                callback(value)
            end
        else
            box.Text = tostring(value)
        end
    end)

    return box
end

--==================================================
-- SWITCH
--==================================================

local function createSwitch(parent, name, y, default, callback)

    label(
        parent,
        name,
        UDim2.fromOffset(145, 28),
        UDim2.fromOffset(5, y),
        14
    )

    local switch = Instance.new("TextButton")
    switch.BackgroundColor3 = Color3.fromRGB(25,25,25)
    switch.Text = ""
    switch.Size = UDim2.fromOffset(46, 22)
    switch.Position = UDim2.fromOffset(160, y + 3)
    switch.Parent = parent

    corner(switch, 11)
    stroke(switch, CONFIG.BorderColor)

    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = CONFIG.BorderColor
    knob.Size = UDim2.fromOffset(18,18)
    knob.Position = UDim2.fromOffset(24,2)
    knob.Parent = switch
    corner(knob, 9)

    local state = default or false

    local function refresh()

        local targetX

        if state then
            targetX = 2
            switch.BackgroundColor3 = Color3.fromRGB(230,230,230)
            knob.BackgroundColor3 = Color3.fromRGB(0,0,0)
        else
            targetX = 24
            switch.BackgroundColor3 = Color3.fromRGB(25,25,25)
            knob.BackgroundColor3 = CONFIG.BorderColor
        end

        TweenService:Create(
            knob,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad),
            {
                Position = UDim2.fromOffset(targetX,2)
            }
        ):Play()

    end

    switch.MouseButton1Click:Connect(function()

        state = not state

        refresh()

        if callback then
            callback(state)
        end

    end)

    refresh()

    return switch, function()
        return state
    end
end

