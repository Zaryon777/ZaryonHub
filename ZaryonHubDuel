local function addValueRow(
    page,
    name,
    initial,
    minValue,
    maxValue,
    step,
    onChanged
)
    local row = Instance.new("Frame")

    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 43)
    row.Parent = page

    local text = label(
        row,
        name,
        14,
        UDim2.new(0, 3, 0, 0),
        UDim2.new(0.48, -3, 1, 0)
    )

    local minus = button(
        row,
        "-",
        UDim2.new(0.55, 0, 0, 4),
        UDim2.new(0, 38, 0, 35)
    )

    local box = Instance.new("TextBox")

    box.BackgroundColor3 = COLORS.Black
    box.BorderSizePixel = 0
    box.TextColor3 = Settings.ButtonTextColor
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.Text = tostring(initial)
    box.ClearTextOnFocus = false
    box.Position = UDim2.new(0.55, 43, 0, 4)
    box.Size = UDim2.new(0, 60, 0, 35)
    box.Parent = row

    corner(box, 6)
    stroke(box, Settings.InterfaceBorderColor, 1)

    local plus = button(
        row,
        "+",
        UDim2.new(0.55, 108, 0, 4),
        UDim2.new(0, 38, 0, 35)
    )

    local current = initial

    local function apply(value)
        value = math.clamp(
            value,
            minValue,
            maxValue
        )

        current = value
        box.Text = tostring(value)

        if onChanged then
            onChanged(value)
        end
    end

    minus.Activated:Connect(function()
        apply(current - step)
    end)

    plus.Activated:Connect(function()
        apply(current + step)
    end)

    box.FocusLost:Connect(function()
        local number = tonumber(box.Text)

        if number then
            apply(number)
        else
            box.Text = tostring(current)
        end
    end)

    return {
        Row = row,
        Set = apply,
        Get = function()
            return current
        end,
        TextBox = box,
    }
end

local function addToggle(page, name, initial, callback)
    local row = Instance.new("Frame")

    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 42)
    row.Parent = page

    local text = label(
        row,
        name,
        14,
        UDim2.new(0, 3, 0, 0),
        UDim2.new(1, -75, 1, 0)
    )

    local toggle = button(
        row,
        "",
        UDim2.new(1, -62, 0.5, -12),
        UDim2.new(0, 55, 0, 24)
    )

    toggle.BackgroundColor3 = COLORS.Black
    toggle.ClipsDescendants = true

    local toggleStroke =
        toggle:FindFirstChildOfClass("UIStroke")

    if toggleStroke then
        toggleStroke.Color =
            Settings.InterfaceBorderColor
    end

    local knob = Instance.new("Frame")

    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(1, -12, 0.5, 0)
    knob.BackgroundColor3 = COLORS.White
    knob.BorderSizePixel = 0
    knob.Parent = toggle

    corner(knob, 20)

    local active = initial == true

    local function render()
        if active then
            toggle.BackgroundColor3 = COLORS.White
            knob.BackgroundColor3 = COLORS.Black

            TweenService:Create(
                knob,
                TweenInfo.new(
                    0.12,
                    Enum.EasingStyle.Quad
                ),
                {
                    Position =
                        UDim2.new(0, 12, 0.5, 0)
                }
            ):Play()
        else
            toggle.BackgroundColor3 = COLORS.Black
            knob.BackgroundColor3 = COLORS.White

            TweenService:Create(
                knob,
                TweenInfo.new(
                    0.12,
                    Enum.EasingStyle.Quad
                ),
                {
                    Position =
                        UDim2.new(1, -12, 0.5, 0)
                }
            ):Play()
        end
    end

    local function set(value)
        active = value
        render()

        if callback then
            callback(active)
        end
    end

    toggle.Activated:Connect(function()
        set(not active)
    end)

    render()

    return {
        Row = row,
        Button = toggle,
        Set = set,
        Get = function()
            return active
        end,
    }
end

local function addChoice(
    page,
    name,
    choices,
    selected,
    callback
)
    local row = Instance.new("Frame")

    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 42)
    row.Parent = page

    label(
        row,
        name,
        14,
        UDim2.new(0, 3, 0, 0),
        UDim2.new(0.45, -3, 1, 0)
    )

    local holder = Instance.new("Frame")

    holder.BackgroundColor3 = COLORS.Black
    holder.Position = UDim2.new(0.45, 0, 0, 4)
    holder.Size = UDim2.new(0.55, -3, 0, 35)
    holder.Parent = row

    corner(holder, 6)
    stroke(
        holder,
        Settings.InterfaceBorderColor,
        1
    )

    local layout = Instance.new("UIListLayout")

    layout.FillDirection =
        Enum.FillDirection.Horizontal
    layout.HorizontalAlignment =
        Enum.HorizontalAlignment.Center
    layout.VerticalAlignment =
        Enum.VerticalAlignment.Center
    layout.Parent = holder

    for _, choice in ipairs(choices) do
        local b = Instance.new("TextButton")

        b.AutoButtonColor = false
        b.Text = choice
        b.Font = Enum.Font.Gotham
        b.TextSize = 12
        b.Size = UDim2.new(0.5, 0, 1, 0)
        b.BorderSizePixel = 0
        b.Parent = holder

        local function render()
            if choice == selected then
                b.BackgroundColor3 = COLORS.White
                b.TextColor3 = COLORS.Black
            else
                b.BackgroundColor3 = COLORS.Black
                b.TextColor3 = Settings.ButtonTextColor
            end
        end

        b.Activated:Connect(function()
            selected = choice

            for _, child in ipairs(
                holder:GetChildren()
            ) do
                if child:IsA("TextButton") then
                    if child.Text == selected then
                        child.BackgroundColor3 =
                            COLORS.White
                        child.TextColor3 =
                            COLORS.Black
                    else
                        child.BackgroundColor3 =
                            COLORS.Black
                        child.TextColor3 =
                            Settings.ButtonTextColor
                    end
                end
            end

            if callback then
                callback(selected)
            end
        end)

        render()
    end

    return row
end

