local function CreateToggle(name, parent, varName, default)
	Variables[varName] = default
	
	local container = Create("Frame", {
		Name = name .. "ToggleContainer",
		Parent = parent,
		Size = UDim2.new(1, -10, 0, 30),
		BackgroundTransparency = 1
	})
	local label = Create("TextLabel", {
		Parent = container,
		Size = UDim2.new(0.7, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = COL_TXT,
		TextSize = 16,
		Font = FONT_MAIN,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	local toggleBtn = Create("TextButton", {
		Parent = container,
		Size = UDim2.new(0, 45, 0, 22),
		Position = UDim2.new(0.7, 10, 0.5, -11),
		BackgroundColor3 = COL_WHITE_GREY, -- Fondo desactivado
		Text = "",
		BorderSizePixel = 0
	})
	Create("UICorner", {Parent = toggleBtn, CornerRadius = UDim.new(1, 0)}) -- Ovalado
	local toggleCircle = Create("Frame", {
		Parent = toggleBtn,
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(1, -20, 0.5, -9), -- Círculo a la derecha por defecto (desactivado)
		BackgroundColor3 = COL_WHITE, -- Círculo blanco
		BorderSizePixel = 0
	})
	Create("UICorner", {Parent = toggleCircle, CornerRadius = UDim.new(1, 0)})

	-- Funcionalidad y Animación
	local function updateToggleState(newState)
		Variables[varName] = newState
		local targetPos = newState and UDim2.new(0, 2, 0.5, -9) or UDim2.new(1, -20, 0.5, -9) -- Izquierda=Activado, Derecha=Desactivado
		local targetBgCol = newState and COL_WHITE or COL_WHITE_GREY
		local targetCircCol = newState and COL_BLACK or COL_WHITE

		local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		TweenService:Create(toggleCircle, tweenInfo, {Position = targetPos}):Play()
		TweenService:Create(toggleBtn, tweenInfo, {BackgroundColor3 = targetBgCol}):Play()
		TweenService:Create(toggleCircle, tweenInfo, {BackgroundColor3 = targetCircCol}):Play()
		
		-- Actualizar Botones Rápidos si existen
		if FeatureElements[varName] and FeatureElements[varName].FastButton then
			UpdateFastButtonVisual(FeatureElements[varName].FastButton, newState)
		end
		-- Ejecutar lógica específica si es necesario
		HandleToggleLogic(varName, newState)
	end

	toggleBtn.MouseButton1Click:Connect(function()
		updateToggleState(not Variables[varName])
	end)
	
	-- Establecer estado inicial sin animación
	updateToggleState(default)
	
	FeatureElements[varName] = {Label = label, ToggleBtn = toggleBtn, ToggleCircle = toggleCircle}
end

