function moveToCoordinate(x, z)
    local root = getRoot()

    if not root then
        return
    end

    local rayOrigin =
        Vector3.new(
            x,
            root.Position.Y + 150,
            z
        )

    local rayDirection =
        Vector3.new(
            0,
            -500,
            0
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances =
        {getCharacter()}

    local result =
        workspace:Raycast(
            rayOrigin,
            rayDirection,
            params
        )

    local y =
        result
        and result.Position.Y + 3
        or root.Position.Y

    root.CFrame =
        CFrame.new(
            x,
            y,
            z
        )
end

local function teleportDown()
    local root = getRoot()

    if not root then
        return
    end

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances =
        {getCharacter()}

    local result =
        workspace:Raycast(
            root.Position,
            Vector3.new(
                0,
                -1000,
                0
            ),
            params
        )

    if result then
        root.CFrame =
            CFrame.new(
                root.Position.X,
                result.Position.Y + 3,
                root.Position.Z
            )
    end
end

