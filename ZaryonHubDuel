local function setStealProgress(value)

    StealProgress = math.clamp(value,0,100)

    PercentLabel.Text = tostring(math.floor(StealProgress)) .. "%"

    tween(
        ProgressFill,
        {
            Size = UDim2.new(
                StealProgress / 100,
                0,
                1,
                0
            )
        },
        0.08
    )

end

----------------------------------------------------------------
-- FPS CALCULATION
----------------------------------------------------------------

local FPS = 60
local frameCounter = 0
local fpsTimer = 0

RunService.RenderStepped:Connect(function(delta)

    frameCounter += 1
    fpsTimer += delta

    if fpsTimer >= 1 then

        FPS = math.floor(frameCounter / fpsTimer)

        frameCounter = 0
        fpsTimer = 0

        FPSLabel.Text = "FPS: " .. tostring(FPS)

    end

end)

