local function createNumberControl(
    parent,
    name,
    defaultValue,
    minValue,
    maxValue,
    callback
)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,0,0,43)
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local label = createText(
        holder,
        name,
        14,
        UDim2.new(0,0,0,0),
        UDim2.new(0.45,0,1,0)
    )

    label.TextXAlignment = Enum.TextXAlignment.Left

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0,34,0,34)
    minus.Position = UDim2.new(0.55,0,0.5,-17)
    minus.BackgroundColor3 = BLACK
    minus.Text = "-"
    minus.TextColor3 = Config.TextColor
    minus.TextSize = 18
    minus.Font = Enum.Font.GothamBold
    minus.AutoButtonColor = false
    minus.Parent = holder

    corner(minus,4)
    stroke(minus,Config.InterfaceBorderColor,1)

    local valueBox = Instance.new("TextBox")
    valueBox.Size = UDim2.new(0,65,0,34)
    valueBox.Position = UDim2.new(0.55,39,0.5,-17)
    valueBox.BackgroundColor3 = Config.ButtonColor
    valueBox.TextColor3 = Config.TextColor
    valueBox.Text = tostring(defaultValue)
    valueBox.TextSize = 14
    valueBox.Font = Enum.Font.GothamMedium
    valueBox.ClearTextOnFocus = false
    valueBox.Parent = holder

    corner(valueBox,4)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0,34,0,34)
    plus.Position = UDim2.new(0.55,109,0.5,-17)
    plus.BackgroundColor3 = BLACK
    plus.Text = "+"
    plus.TextColor3 = Config.TextColor
    plus.TextSize = 18
    plus.Font = Enum.Font.GothamBold
    plus.AutoButtonColor = false
    plus.Parent = holder

    corner(plus,4)
    stroke(plus,Config.InterfaceBorderColor,1)

    local current = defaultValue

    local function setValue(value)

        value = math.clamp(value,minValue,maxValue)

        current = value
        valueBox.Text = tostring(value)

        if callback then
            callback(value)
        end
    end

    minus.MouseButton1Click:Connect(function()
        setValue(current - 1)
    end)

    plus.MouseButton1Click:Connect(function()
        setValue(current + 1)
    end)

    valueBox.FocusLost:Connect(function()

        local number = tonumber(valueBox.Text)

        if number then
            setValue(number)
        else
            valueBox.Text = tostring(current)
        end

    end)

    return holder, setValue
end

----------------------------------------------------------------
-- TOGGLE
----------------------------------------------------------------

local function createToggle(
    parent,
    name,
    defaultValue,
    callback
)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,0,0,42)
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local label = createText(
        holder,
        name,
        14,
        UDim2.new(0,0,0,0),
        UDim2.new(0.68,0,1,0)
    )

    label.TextXAlignment = Enum.TextXAlignment.Left

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0,54,0,28)
    toggle.Position = UDim2.new(1,-58,0.5,-14)
    toggle.BackgroundColor3 = BLACK
    toggle.Text = ""
    toggle.AutoButtonColor = false
    toggle.Parent = holder

    corner(toggle,14)
    stroke(toggle,Config.InterfaceBorderColor,1)

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0,22,0,22)
    circle.Position = UDim2.new(1,-26,0.5,-11)
    circle.BackgroundColor3 = WHITE
    circle.Parent = toggle

    corner(circle,20)

    local enabled = defaultValue

    local function setEnabled(state)

        enabled = state

        if enabled then

            tween(toggle,{
                BackgroundColor3 = WHITE
            },0.14)

            tween(circle,{
                Position = UDim2.new(0,4,0.5,-11),
                BackgroundColor3 = BLACK
            },0.14)

        else

            tween(toggle,{
                BackgroundColor3 = BLACK
            },0.14)

            tween(circle,{
                Position = UDim2.new(1,-26,0.5,-11),
                BackgroundColor3 = WHITE
            },0.14)

        end

        if callback then
            callback(enabled)
        end
    end

    toggle.MouseButton1Click:Connect(function()
        setEnabled(not enabled)
    end)

    setEnabled(enabled)

    return holder, setEnabled
end

