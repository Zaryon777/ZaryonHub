end)

-- RenderStepped principal (FPS, Ping y Velocidades)
local frameCount, lastCalc, currentFPS = 0, os.clock(), 60

RunService.RenderStepped:Connect(function()
	frameCount = frameCount + 1
	if os.clock() - lastCalc >= 1 then
		currentFPS = frameCount
		frameCount = 0
		lastCalc = os.clock()
	end
	
	local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	StatsText.Text = "Fps: " .. currentFPS .. "  Ping: " .. ping .. "ms"
	
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Humanoid") then
		local hum = char.Humanoid
		
		-- Velocidades intercaladas
		if Settings.LaggerSpeedActive then hum.WalkSpeed = Settings.LaggerSpeed
		elseif Settings.LaggerCarryActive then hum.WalkSpeed = Settings.LaggerCarry
		elseif Settings.CarrySpeedActive then hum.WalkSpeed = Settings.CarrySpeed
		else hum.WalkSpeed = Settings.Speed end
		
		-- Hold Jump
		if Settings.JumpMode == "Hold" and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

-- Salto Infinito
UserInputService.JumpRequest:Connect(function()
