			Size = UDim2.new(1 / #modes, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = mode,
			TextColor3 = COL_TXT,
			TextSize = 14,
			Font = FONT_MAIN,
			LayoutOrder = i
		})
		
		if i < #modes then
			local separator = Create("Frame", {
				Parent = modeBtn,
				Size = UDim2.new(0, 1, 1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				BackgroundColor3 = COL_BORDER,
				BorderSizePixel = 0
			})
		end
		
		modeButtons[mode] = modeBtn
		
		modeBtn.MouseButton1Click:Connect(function()
			SetMode(varName, mode)
		end)
	end

	-- Funcionalidad
	function SetMode(vName, selectedMode)
		Variables[vName] = selectedMode
		for mode, btn in pairs(modeButtons) do
			if mode == selectedMode then
				AnimateColor(btn, "TextColor3", COL_BLACK, 0.1)
				btn.BackgroundTransparency = 0
				btn.BackgroundColor3 = COL_WHITE
			else
				AnimateColor(btn, "TextColor3", COL_TXT, 0.1)
				btn.BackgroundTransparency = 1
			end
		end
		-- Lógica específica
		if vName == "JumpMode" then HandleJumpModeLogic(selectedMode) end
	end
	
	-- Establecer modo inicial
	SetMode(varName, default)
	
	FeatureElements[varName] = {Label = label, ModesFrame = modesFrame, Buttons = modeButtons}
end

