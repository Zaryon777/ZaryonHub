local function colorPicker(parent, title, y, default, callback)

    label(
        parent,
        title,
        UDim2.fromOffset(145,28),
        UDim2.fromOffset(5,y),
        14
    )

    local preview = button(
        parent,
        "",
        UDim2.fromOffset(35,28),
        UDim2.fromOffset(170,y)
    )

    preview.BackgroundColor3 = default

    local colors = {
        Color3.fromRGB(255,255,255),
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,128,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(255,0,170),
        Color3.fromRGB(170,0,255),
        Color3.fromRGB(0,120,255),
        Color3.fromRGB(0,255,150),
    }

    local pickerOpen = false

    preview.MouseButton1Click:Connect(function()

        pickerOpen = not pickerOpen

        if pickerOpen then

            for i,color in ipairs(colors) do

                local c = Instance.new("TextButton")
                c.Text = ""
                c.AutoButtonColor = false
                c.BackgroundColor3 = color
                c.Size = UDim2.fromOffset(22,22)
                c.Position = UDim2.fromOffset(
                    210 + ((i-1)%4)*27,
                    y + math.floor((i-1)/4)*27
                )
                c.Parent = parent
                corner(c,4)
                stroke(c)

                c.MouseButton1Click:Connect(function()

                    preview.BackgroundColor3 = color

                    if callback then
                        callback(color)
                    end

                    for _,obj in ipairs(parent:GetChildren()) do
                        if obj:IsA("TextButton")
                        and obj ~= preview
                        and obj.Position.X.Offset >= 210 then
                            obj:Destroy()
                        end
                    end

                    pickerOpen = false
                end)
            end

        end
    end)
end

