local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = obj
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or CONFIG.BorderColor
    s.Thickness = thickness or 1
    s.Parent = obj
    return s
end

local function label(parent, text, size, position, textSize)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = CONFIG.TextColor
    l.Font = Enum.Font.Gotham
    l.TextSize = textSize or 14
    l.Size = size
    l.Position = position
    l.Parent = parent
    return l
end

local function button(parent, text, size, position)
    local b = Instance.new("TextButton")
    b.AutoButtonColor = false
    b.BackgroundColor3 = CONFIG.ButtonColor
    b.TextColor3 = CONFIG.TextColor
    b.Font = Enum.Font.Gotham
    b.TextSize = 13
    b.Text = text
    b.Size = size
    b.Position = position
    b.Parent = parent
    corner(b, 7)
    stroke(b)
    return b
end

local function separator(parent, position, size)
    local line = Instance.new("Frame")
    line.BackgroundColor3 = CONFIG.BorderColor
    line.BorderSizePixel = 0
    line.Position = position
    line.Size = size
    line.Parent = parent
    return line
end

