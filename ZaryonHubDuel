--========================================================
-- SPEED SYSTEM
--========================================================

local function GetSpeed()

	if State.LaggerCarryEnabled then
		return State.LaggerCarry

	elseif State.LaggerSpeedEnabled then
		return State.LaggerSpeed

	elseif State.Carry then
		return State.CarrySpeed

	else
		return State.Speed
	end

end

local function ApplySpeed()

	if Humanoid then
		Humanoid.WalkSpeed = GetSpeed()
	end

end

