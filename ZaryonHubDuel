--========================================================
-- TOGGLE
--========================================================

local function Toggle(
	Parent,
	Initial,
	Callback,
	Y
)

	local Button = Instance.new("TextButton")

	Button.AutoButtonColor = false
	Button.Text = ""

	Button.Size = UDim2.fromOffset(52,26)
	Button.Position = UDim2.new(1,-57,0,Y+3)

	Button.BackgroundColor3 =
		Initial and State.White or State.ButtonColor

	Button.Parent = Parent

	AddCorner(Button,13)

	local Border = AddStroke(
		Button,
		State.InterfaceBorder,
		1
	)

	local Knob = Instance.new("Frame")

	Knob.Size = UDim2.fromOffset(18,18)

	Knob.Position =
		Initial
		and UDim2.new(1,-22,0.5,-9)
		or UDim2.fromOffset(4,4)

	Knob.BackgroundColor3 =
		Initial and State.Black or State.White

	Knob.Parent = Button

	AddCorner(Knob,9)

	local Enabled = Initial

	local function Render()

		TweenService:Create(
			Button,
			TweenInfo.new(.16),
			{
				BackgroundColor3 =
					Enabled
					and State.White
					or State.ButtonColor
			}
		):Play()

		TweenService:Create(
			Knob,
			TweenInfo.new(.16),
			{
				Position =
					Enabled
					and UDim2.new(1,-22,.5,-9)
					or UDim2.fromOffset(4,4),

				BackgroundColor3 =
					Enabled
					and State.Black
					or State.White
			}
		):Play()

		Callback(Enabled)

	end

	Button.Activated:Connect(function()

		Enabled = not Enabled

		Render()

	end)

	return {

		Button = Button,

		Set = function(Value)

			Enabled = Value
			Render()

		end,

		Get = function()

			return Enabled

		end

	}

end

--========================================================
-- NUMBER CONTROL
--========================================================

local function NumberControl(
	Parent,
	Name,
	Get,
	Set,
	Y,
	Step
)

	Row(Parent,Name,Y)

	local Minus = CreateButton(
		Parent,
		"-",
		UDim2.fromOffset(32,30),
		UDim2.new(1,-150,0,Y)
	)

	local ValueBox = Instance.new("TextBox")

	ValueBox.ClearTextOnFocus = false

	ValueBox.Size = UDim2.fromOffset(58,30)
	ValueBox.Position = UDim2.new(1,-112,0,Y)

	ValueBox.BackgroundTransparency = 1

	ValueBox.Text = tostring(Get())

	ValueBox.TextColor3 = State.TextColor

	ValueBox.Font = Enum.Font.Gotham
	ValueBox.TextSize = 15

	ValueBox.Parent = Parent

	local Plus = CreateButton(
		Parent,
		"+",
		UDim2.fromOffset(32,30),
		UDim2.new(1,-50,0,Y)
	)

	local function Update()

		ValueBox.Text = tostring(Get())

	end

	Minus.Activated:Connect(function()

		Set(Get()-Step)
		Update()

	end)

	Plus.Activated:Connect(function()

		Set(Get()+Step)
		Update()

	end)

	ValueBox.FocusLost:Connect(function()

		local N = tonumber(ValueBox.Text)

		if N then
			Set(N)
		end

		Update()

	end)

	return ValueBox

end

