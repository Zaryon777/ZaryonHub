--==================================================
-- FPS / PING / PROGRESS
--==================================================

local progressValue = 0
local direction = 1
local autoStealVisual = false
local lastMoveTime = tick()

local function isMoving()

    local character = Player.Character

    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return false
    end

    return humanoid.MoveDirection.Magnitude > 0.05
end

RunService.RenderStepped:Connect(function(dt)

    -- FPS
    local fps = math.floor(1 / math.max(dt,0.001))

    FPS.Text = "FPS: "..tostring(fps)

    -- Progress visual
    if isMoving() then
        lastMoveTime = tick()
        autoStealVisual = true
    elseif tick() - lastMoveTime >= 5 then
        autoStealVisual = false
        progressValue = 0
    end

    if autoStealVisual then

        -- 3 segundos 0 -> 100
        progressValue += (100 / 3) * dt

        if progressValue >= 100 then
            progressValue = 0
        end

    end

    Fill.Size = UDim2.new(
        math.clamp(progressValue/100,0,1),
        0,
        1,
        0
    )

    Percent.Text = tostring(math.floor(progressValue)).."%"

end)

