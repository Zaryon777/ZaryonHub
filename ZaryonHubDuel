-- ====================================================================
-- LOOP DE MOTOR Y EVENTOS
-- ====================================================================
local fpsCount, lastUpdate, currentFPS = 0, os.clock(), 60

RunService.RenderStepped:Connect(function()
	fpsCount = fpsCount + 1
	if os.clock() - lastUpdate >= 1 then
		currentFPS = fpsCount
		fpsCount = 0
		lastUpdate = os.clock()
	end
	
	local pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	StatsLabel.Text = "67%   Fps: " .. currentFPS .. "  Ping: " .. pingVal .. "ms"
	
	-- Ajuste de Velocidad dinámico
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Humanoid") then
		local hum = char.Humanoid
		if State.LaggerSpeedActive then hum.WalkSpeed = State.LaggerSpeed
		elseif State.LaggerCarryActive then hum.WalkSpeed = State.LaggerCarry
		elseif State.CarrySpeedActive then hum.WalkSpeed = State.CarrySpeed
		else hum.WalkSpeed = State.Speed end
		
		if State.AutoRight then
			char.HumanoidRootPart.CFrame = CFrame.new(-74.875, char.HumanoidRootPart.Position.Y, -24.304)
		elseif State.AutoLeft then
			char.HumanoidRootPart.CFrame = CFrame.new(-74.875, char.HumanoidRootPart.Position.Y, 41.646)
		end
	end
end)

UserInputService.JumpRequest:Connect(function()
	if State.InfinityJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)
