local quickLayout = {
	{Name = "Bat TP", Pos = Vector2.new(0, 0)},
	{Name = "Auto Left", Pos = Vector2.new(60, 0)},
	{Name = "Auto Right", Pos = Vector2.new(120, 0)},
	{Name = "TP Down", Pos = Vector2.new(60, 50)},
	{Name = "Carry Speed", Pos = Vector2.new(120, 50)},
	{Name = "Anti Bat Bypass", Pos = Vector2.new(60, 100)},
	{Name = "Lagger Carry", Pos = Vector2.new(120, 100)},
	{Name = "Reset", Pos = Vector2.new(60, 150)},
	{Name = "Lagger Speed", Pos = Vector2.new(120, 150)}
}

for _, item in ipairs(quickLayout) do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 54, 0, 44)
	b.Position = UDim2.new(0, item.Pos.X, 0, item.Pos.Y)
	b.BackgroundColor3 = Theme.InactiveBtn
	b.TextColor3 = Theme.Text
	b.Text = item.Name
	b.TextWrapped = true
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.AutoButtonColor = false
	b.Parent = RightContainer
	
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	local bStroke = Instance.new("UIStroke", b)
	bStroke.Color = Theme.Accent

	local active = false
	b.MouseButton1Click:Connect(function()
		active = not active
		TweenService:Create(b, TweenInfo.new(0.15), {
			BackgroundColor3 = active and Theme.ActiveBtn or Theme.InactiveBtn,
			TextColor3 = active and Theme.TextDark or Theme.Text
		}):Play()

		-- Lógica asociada
		if item.Name == "Carry Speed" then State.CarrySpeedActive = active
		elseif item.Name == "Lagger Carry" then State.LaggerCarryActive = active
		elseif item.Name == "Lagger Speed" then State.LaggerSpeedActive = active
		elseif item.Name == "Bat TP" then State.BatTP = active
		elseif item.Name == "Anti Bat Bypass" then State.AntiBatBypass = active
		elseif item.Name == "Auto Right" then State.AutoRight = active
		elseif item.Name == "Auto Left" then State.AutoLeft = active
		elseif item.Name == "TP Down" then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local ray = Ray.new(char.HumanoidRootPart.Position, Vector3.new(0, -500, 0))
				local _, hit = workspace:FindPartOnRay(ray, char)
				if hit then char.HumanoidRootPart.CFrame = CFrame.new(hit + Vector3.new(0, 3, 0)) end
			end
		elseif item.Name == "Reset" then
			if LocalPlayer.Character then LocalPlayer.Character:BreakJoints() end
		end
	end)
end

