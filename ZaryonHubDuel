local function activateKeybind(action)

    if action == "Auto Right" then

        SetAutoRightButton(not Config.AutoRight)

    elseif action == "Auto Left" then

        SetAutoLeftButton(not Config.AutoLeft)

    elseif action == "Bat TP" then

        SetBatButton(not Config.BatTP)

    elseif action == "Anti Bat Bypass" then

        SetAntiBatButton(not Config.AntiBatBypass)

    elseif action == "Carry Speed" then

        SetCarryButton(not Config.Carry)

    elseif action == "Lagger Carry" then

        SetLaggerCarryButton(not Config.LaggerCarryEnabled)

    elseif action == "Lagger Speed" then

        SetLaggerSpeedButton(not Config.LaggerSpeedEnabled)

    elseif action == "Drop Brainrot" then

        SetDropButton(not Config.DropBrainrot)

    elseif action == "TP Down" then

        SetTPDownButton(not Config.TPDown)

    elseif action == "Reset" then

        if Humanoid then
            Humanoid.Health = 0
        end

    end

end

UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if gameProcessed then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    for action,key in pairs(Keybinds) do

        if input.KeyCode == key then

            activateKeybind(action)

            break

        end

    end

end)

