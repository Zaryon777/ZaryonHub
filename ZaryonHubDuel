-- Función para cambiar de categoría
function SwitchCategory(categoryName)
	CurrentCategory = categoryName
	-- Actualizar resaltado de botones de categoría
	for name, data in pairs(CategoryButtons) do
		if name == categoryName then
			AnimateColor(data.Highlight, "BackgroundTransparency", 0, 0.1)
			AnimateColor(data.Button, "TextColor3", COL_BLACK, 0.1)
		else
			AnimateColor(data.Highlight, "BackgroundTransparency", 1, 0.1)
			AnimateColor(data.Button, "TextColor3", COL_TXT, 0.1)
		end
	end
	
	-- Limpiar contenido actual
	for _, child in pairs(ContentFrame:GetChildren()) do
		if not child:IsA("UIListLayout") then child:Destroy() end
	end
	
	-- Cargar contenido de la categoría seleccionada
	if categoryName == "Speed" then
		CreateContentHeader("Speed", ContentFrame)
		CreateVariableSlider("Speed", ContentFrame, "Speed", 16, 200, 59)
