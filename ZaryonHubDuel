-- Bucle Auto Stealer (Porcentaje que recarga al moverse y reinicia a 0% al estar quieto)
local idleTime = 0
local lastPos = Vector3.zero

RunService.Heartbeat:Connect(function(dt)
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local currentPos = char.HumanoidRootPart.Position
		local moved = (currentPos - lastPos).Magnitude > 0.1 or Settings.AutoRight or Settings.AutoLeft
		lastPos = currentPos
		
		if moved then
			idleTime = 0
			Settings.StealProgress = math.min(100, Settings.StealProgress + (dt * 20)) -- Carga a 100%
		else
			idleTime = idleTime + dt
			if idleTime >= 3 then
				Settings.StealProgress = 0 -- Se reinicia al 0% tras 3s quieto
			end
		end
		
		Fill.Size = UDim2.new(Settings.StealProgress / 100, 0, 1, 0)
		PctText.Text = math.floor(Settings.StealProgress) .. "%"
	end
end)

-- Bucle BAT TP y Auto Bat Bypass (Ataque y Teletransporte)
task.spawn(function()
	local angle = 0
	while true do
		task.wait(0.05)
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			-- BAT TP: Teletransporta al jugador más cercano arriba de su cabeza y gira
			if Settings.BatTP then
				local target = nil
				local minDist = math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						local d = (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
						if d < minDist then minDist = d; target = p.Character.HumanoidRootPart end
					end
				end
				if target then
					angle = angle + math.rad(Settings.AimbotSpeed)
					local offset = Vector3.new(math.cos(angle) * 3, 4, math.sin(angle) * 3)
					target.CFrame = CFrame.new(char.HumanoidRootPart.Position + offset, char.HumanoidRootPart.Position)
				end
			end
			
			-- Auto Bat Bypass: Vuela hacia el objetivo y hace clic con slot 1 cada 0.5s
			if Settings.AntiBatBypass then
				local target = nil
				local minDist = math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						local d = (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
						if d < minDist then minDist = d; target = p.Character.HumanoidRootPart end
					end
				end
				if target then
					char.HumanoidRootPart.CFrame = CFrame.new(target.Position + Vector3.new(0, 0, 2))
				end
			end
		end
	end
end)

