----------------------------------------------------------------

RunService.Heartbeat:Connect(function(delta)

    if not Character or not Humanoid then
        return
    end

    local moving = Humanoid.MoveDirection.Magnitude > 0.05

    if moving then
        LastMovement = tick()
        WasMoving = true
    end

    if not Config.AutoSteal then

        setStealProgress(0)

        return

    end

    if not moving and tick() - LastMovement >= 3 then

        setStealProgress(0)

        return

    end

    if moving or Config.AutoRight or Config.AutoLeft then

        StealProgress += delta * 18

        if StealProgress >= 100 then

            StealProgress = 100

            -- TODO:
            -- Aquí puedes colocar la interacción con los
            -- ProximityPrompt de TU propia experiencia.
            --
            -- Por ejemplo:
            --
            -- local prompt = ...
            -- fireproximityprompt(prompt)
            --
            -- La lógica debe pertenecer a tu propio juego.

        end

        setStealProgress(StealProgress)

    end

end)

