-- ====================================================================
-- SISTEMA DE NAVEGACIÓN Y PESTAÑAS DINÁMICAS
-- ====================================================================
local Categories = {"Speed", "Combat", "Steal", "Movement", "Misc", "Visual", "Interface", "Keybinds"}
local Tabs, NavBtns = {}, {}

for i, cat in ipairs(Categories) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.88, 0, 0, 28)
	btn.Position = UDim2.new(0.06, 0, 0, (i - 1) * 33 + 6)
	btn.BackgroundColor3 = (cat == "Speed") and Theme.ActiveBtn or Theme.InactiveBtn
	btn.TextColor3 = (cat == "Speed") and Theme.TextDark or Theme.Text
	btn.Text = cat
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 13
	btn.AutoButtonColor = false
	btn.Parent = NavContainer
	
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Color = Theme.Accent
	stroke.Thickness = 1
	
	NavBtns[cat] = {Button = btn, Stroke = stroke}
	
	local page = Instance.new("ScrollingFrame")
	page.Size = UDim2.new(1, -10, 1, -10)
	page.Position = UDim2.new(0, 5, 0, 5)
	page.BackgroundTransparency = 1
	page.Visible = (cat == "Speed")
	page.ScrollBarThickness = 3
	page.Parent = ContentContainer
	Tabs[cat] = page
	
	btn.MouseButton1Click:Connect(function()
		for name, p in pairs(Tabs) do p.Visible = (name == cat) end
		for name, bData in pairs(NavBtns) do
			local active = (name == cat)
			TweenService:Create(bData.Button, TweenInfo.new(0.2), {
				BackgroundColor3 = active and Theme.ActiveBtn or Theme.InactiveBtn,
				TextColor3 = active and Theme.TextDark or Theme.Text
			}):Play()
		end
	end)
end

-- Animación Abrir/Cerrar Menú
local menuOpen = false
MenuBtn.MouseButton1Click:Connect(function()
	menuOpen = not menuOpen
	if menuOpen then
		MainFrame.Visible = true
		MainFrame.Size = UDim2.new(0, 0, 0, 0)
		TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 440, 0, 320)
		}):Play()
		TweenService:Create(MenuBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ActiveBtn, TextColor3 = Theme.TextDark}):Play()
	else
		local tween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0)
		})
		tween:Play()
		tween.Completed:Connect(function() if not menuOpen then MainFrame.Visible = false end end)
		TweenService:Create(MenuBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.InactiveBtn, TextColor3 = Theme.Text}):Play()
	end
end)

