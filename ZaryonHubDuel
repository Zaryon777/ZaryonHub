local function CreateNumberSetting(parent, text, defaultVal, yPos, callback)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.5, 0, 0, 24)
	label.Position = UDim2.new(0.05, 0, 0, yPos)
	label.Text = text
	label.TextColor3 = Theme.ButtonText
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.SourceSans
	label.TextSize = 15
	label.BackgroundTransparency = 1
	label.Parent = parent
	
	local minus = Instance.new("TextButton")
	minus.Size = UDim2.new(0, 22, 0, 22)
	minus.Position = UDim2.new(0.55, 0, 0, yPos)
	minus.BackgroundColor3 = Theme.ButtonBg
	minus.TextColor3 = Theme.ButtonText
	minus.Text = "-"
	minus.Parent = parent
	Instance.new("UIStroke", minus).Color = Theme.Borders
	
	local valBox = Instance.new("TextBox")
	valBox.Size = UDim2.new(0, 36, 0, 22)
	valBox.Position = UDim2.new(0.55, 25, 0, yPos)
	valBox.Text = tostring(defaultVal)
	valBox.TextColor3 = Theme.ButtonText
	valBox.BackgroundColor3 = Theme.ButtonBg
	valBox.Parent = parent
	Instance.new("UIStroke", valBox).Color = Theme.Borders
	
	local plus = Instance.new("TextButton")
	plus.Size = UDim2.new(0, 22, 0, 22)
	plus.Position = UDim2.new(0.55, 64, 0, yPos)
	plus.BackgroundColor3 = Theme.ButtonBg
	plus.TextColor3 = Theme.ButtonText
	plus.Text = "+"
	plus.Parent = parent
	Instance.new("UIStroke", plus).Color = Theme.Borders
	
	local val = defaultVal
	local function update(n)
		val = math.max(0, n)
		valBox.Text = tostring(val)
		callback(val)
	end
	
	minus.MouseButton1Click:Connect(function() update(val - 1) end)
	plus.MouseButton1Click:Connect(function() update(val + 1) end)
	valBox.FocusLost:Connect(function() update(tonumber(valBox.Text) or val) end)
end

local function CreateToggle(parent, text, yPos, callback)
	local label = Instance.new("TextLabel")
